# Copia este archivo como `.env` en la raíz y rellena los valores reales.
# `.env` está ignorado por Git: no subas credenciales al repositorio.

# Secretos del servidor (server/): nunca llevan el prefijo EXPO_PUBLIC_.
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=voluntapp
PORT=3000
HOST=127.0.0.1

# URL pública del backend que consume la app de Expo.
# Simulador de iOS: http://localhost:3000
# Emulador de Android: http://10.0.2.2:3000
#   (o mantén localhost y ejecuta `adb reverse tcp:3000 tcp:3000`)
# Teléfono físico: http://IP_LAN_DE_TU_COMPUTADORA:3000 con HOST=0.0.0.0
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
