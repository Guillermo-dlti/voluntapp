# Copy to .env and fill in real values locally. Never commit .env.

# Server only. Atlas → Connect → Drivers → Node.js, with the database user's credentials.
# Never prefix these with EXPO_PUBLIC_ (that would ship them inside the APK).
MONGODB_URI=
MONGODB_DB=voluntapp
PORT=3000
# 127.0.0.1 for the emulator (with adb reverse); 0.0.0.0 for a physical phone on your LAN.
HOST=127.0.0.1

# App (public, bundled into the APK): where the app reaches the API.
# Emulator with adb reverse: http://localhost:3000 · physical phone: http://YOUR_LAN_IP:3000
EXPO_PUBLIC_API_URL=http://localhost:3000
